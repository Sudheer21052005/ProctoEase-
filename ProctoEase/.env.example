# ─── Database ───
POSTGRES_USER=proctoease
POSTGRES_PASSWORD=changeme_in_production
POSTGRES_DB=proctoease
DATABASE_URL=postgresql+asyncpg://proctoease:changeme_in_production@db:5432/proctoease

# ─── JWT ───
SECRET_KEY=dev-secret-key-not-for-production-use-replace-me-with-random
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── App ──
APP_ENV=development
DEBUG=true
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:5174","http://localhost:5175"]

# ─── Judge0 ───
JUDGE0_API_URL=http://judge0-server:2358

# ─── Redis ───
REDIS_URL=redis://redis:6379

# ─── Rate Limiting ───
RATE_LIMIT_ENABLED=true
